{
  "name": "ekphrasis",
  "version": "0.0.0",
  "private": true,
  "description": "Fills YAML files in Obsidian through forms generated from JSON Schemas.",
  "author": "Esther Poniatowski",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node config/tools/esbuild.config.mjs",
    "build": "tsc --noEmit && node config/tools/esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config config/tools/eslint.config.mjs src tests",
    "format": "prettier --config config/tools/prettier.json --ignore-path config/tools/prettier.ignore --write src tests",
    "format:check": "prettier --config config/tools/prettier.json --ignore-path config/tools/prettier.ignore --check src tests",
    "test": "vitest run --config config/tools/vitest.config.ts",
    "test:watch": "vitest --config config/tools/vitest.config.ts",
    "check:links": "node scripts/check-links.mjs",
    "test-vault": "node scripts/test-vault.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "preact": "^11.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "happy-dom": "^21.0.3",
    "obsidian": "latest",
    "prettier": "^3.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
