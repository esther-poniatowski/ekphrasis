{
  "name": "ekphrasis",
  "version": "0.0.0",
  "private": true,
  "description": "Fills YAML files in Obsidian through forms generated from JSON Schemas.",
  "author": "Esther Poniatowski",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node config/tools/esbuild.config.mjs",
    "dev:spikes": "node config/tools/esbuild.config.mjs --target=spikes",
    "build": "tsc --noEmit && node config/tools/esbuild.config.mjs production",
    "build:spikes": "node config/tools/esbuild.config.mjs production --target=spikes",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config config/tools/eslint.config.mjs src tests spikes/src",
    "format": "prettier --config config/tools/prettier.json --write src tests spikes/src",
    "format:check": "prettier --config config/tools/prettier.json --check src tests spikes/src",
    "test": "vitest run --config config/tools/vitest.config.ts",
    "test:watch": "vitest --config config/tools/vitest.config.ts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "preact": "^11.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "obsidian": "latest",
    "prettier": "^3.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
